{
  "title": "What thor-demo adds to an aidemo workflow",
  "targetLengthSeconds": 55,
  "captions": {
    "style": "none",
    "track": true
  },
  "hold": {
    "mode": "freeze"
  },
  "attention": {
    "color": "#8cc8ff",
    "cursorClear": true
  },
  "cursor": {
    "hidden": true
  },
  "hide": ["nav"],
  "voice": {
    "pronounce": {
      "aidemo": "A.I. demo",
      "aidemo’s": "A.I. demo’s",
      "MCP": "M.C.P.",
      "mlx-audio": "M.L.X. audio",
      "OpenAI": "Open A.I.",
      "thor-demo": "thor demo"
    }
  },
  "output": {
    "chapters": true
  },
  "scenes": [
    {
      "id": "open",
      "title": "What thor-demo adds",
      "narration": "You’re hearing {{@voice}}my voice, cloned on this laptop. {{@aidemo}}aidemo renders demos; {{@adds}}thor-demo adds three things.",
      "actions": [
        {
          "op": "goto",
          "url": "http://127.0.0.1:8787/adds/01-open.html"
        },
        {
          "op": "waitFor",
          "target": {
            "selector": "#core"
          }
        },
        {
          "op": "pause",
          "ms": 500
        },
        {
          "op": "highlight",
          "target": {
            "selector": "#badge"
          },
          "holdMs": 2200,
          "anchor": "voice"
        },
        {
          "op": "pause",
          "ms": 400
        },
        {
          "op": "spotlight",
          "target": {
            "selector": "#core"
          },
          "holdMs": 1450,
          "anchor": "aidemo"
        },
        {
          "op": "click",
          "target": {
            "selector": "#ring-label"
          }
        },
        {
          "op": "spotlight",
          "target": {
            "selector": "#ring"
          },
          "holdMs": 2100,
          "anchor": "adds"
        },
        {
          "op": "pause",
          "ms": 1600
        }
      ]
    },
    {
      "id": "config",
      "title": "Per-repository configuration",
      "narration": "A shell and an agent’s {{@paths}}MCP server see different environments; {{@key}}an inherited OpenAI key sends captions off this machine. {{@file}}One file per repository fixes both: {{@strip}}thor-demo drops the key unless the file allows it.",
      "actions": [
        {
          "op": "goto",
          "url": "http://127.0.0.1:8787/adds/02-config.html"
        },
        {
          "op": "waitFor",
          "target": {
            "selector": "#launches"
          }
        },
        {
          "op": "pause",
          "ms": 700
        },
        {
          "op": "spotlight",
          "target": {
            "selector": "#launches"
          },
          "holdMs": 2800,
          "anchor": "paths"
        },
        {
          "op": "pause",
          "ms": 2200
        },
        {
          "op": "highlight",
          "target": {
            "selector": "#mcp-key"
          },
          "holdMs": 3000,
          "anchor": "key"
        },
        {
          "op": "pause",
          "ms": 1800
        },
        {
          "op": "click",
          "target": {
            "selector": "#gate"
          }
        },
        {
          "op": "spotlight",
          "target": {
            "selector": "#gate"
          },
          "holdMs": 2550,
          "anchor": "file"
        },
        {
          "op": "pause",
          "ms": 400
        },
        {
          "op": "click",
          "target": {
            "selector": "#mcp-key"
          }
        },
        {
          "op": "highlight",
          "target": {
            "selector": "#mcp-key"
          },
          "holdMs": 3000,
          "anchor": "strip"
        },
        {
          "op": "pause",
          "ms": 3200
        }
      ]
    },
    {
      "id": "archive",
      "title": "Archived takes",
      "narration": "Each render {{@overwrite}}overwrites the last. thor-demo {{@files}}files every take by time and commit, {{@provenance}}with a provenance record: {{@engine}}engine, {{@voice}}voice, {{@options}}options, {{@hashes}}and a hash of every file.",
      "actions": [
        {
          "op": "goto",
          "url": "http://127.0.0.1:8787/adds/03-archive.html"
        },
        {
          "op": "waitFor",
          "target": {
            "selector": "#folder"
          }
        },
        {
          "op": "pause",
          "ms": 200
        },
        {
          "op": "click",
          "target": {
            "selector": "#out-new"
          }
        },
        {
          "op": "spotlight",
          "target": {
            "selector": "#folder"
          },
          "holdMs": 2050,
          "anchor": "overwrite"
        },
        {
          "op": "pause",
          "ms": 300
        },
        {
          "op": "click",
          "target": {
            "selector": "#shelf-head"
          }
        },
        {
          "op": "spotlight",
          "target": {
            "selector": "#shelf"
          },
          "holdMs": 2450,
          "anchor": "files"
        },
        {
          "op": "pause",
          "ms": 300
        },
        {
          "op": "click",
          "target": {
            "selector": "#take-latest"
          }
        },
        {
          "op": "spotlight",
          "target": {
            "selector": "#prov"
          },
          "holdMs": 1700,
          "anchor": "provenance"
        },
        {
          "op": "highlight",
          "target": {
            "selector": "#prov-engine"
          },
          "holdMs": 450,
          "anchor": "engine"
        },
        {
          "op": "highlight",
          "target": {
            "selector": "#prov-voice"
          },
          "holdMs": 400,
          "anchor": "voice"
        },
        {
          "op": "highlight",
          "target": {
            "selector": "#prov-options"
          },
          "holdMs": 500,
          "anchor": "options"
        },
        {
          "op": "highlight",
          "target": {
            "selector": "#prov-files"
          },
          "holdMs": 1850,
          "anchor": "hashes"
        },
        {
          "op": "pause",
          "ms": 2000
        }
      ]
    },
    {
      "id": "voice",
      "title": "Voice clone",
      "narration": "aidemo’s local {{@stock}}voice isn’t mine. {{@clone}}thor-demo clones mine from a short recording; {{@proxy}}revoice swaps the narration through a proxy {{@mlx}}and mlx-audio, {{@local}}all on this machine, {{@kept}}and keeps the recording.",
      "actions": [
        {
          "op": "goto",
          "url": "http://127.0.0.1:8787/adds/04-voice.html"
        },
        {
          "op": "waitFor",
          "target": {
            "selector": "#voice-core"
          }
        },
        {
          "op": "pause",
          "ms": 700
        },
        {
          "op": "highlight",
          "target": {
            "selector": "#voice-stock"
          },
          "holdMs": 1200,
          "anchor": "stock"
        },
        {
          "op": "pause",
          "ms": 200
        },
        {
          "op": "click",
          "target": {
            "selector": "#profile"
          }
        },
        {
          "op": "spotlight",
          "target": {
            "selector": "#profile"
          },
          "holdMs": 3000,
          "anchor": "clone"
        },
        {
          "op": "pause",
          "ms": 300
        },
        {
          "op": "click",
          "target": {
            "selector": "#proxy"
          }
        },
        {
          "op": "spotlight",
          "target": {
            "selector": "#proxy"
          },
          "holdMs": 3000,
          "anchor": "proxy"
        },
        {
          "op": "click",
          "target": {
            "selector": "#mlx"
          }
        },
        {
          "op": "click",
          "target": {
            "selector": "#off-machine"
          }
        },
        {
          "op": "spotlight",
          "target": {
            "selector": "#mlx"
          },
          "holdMs": 950,
          "anchor": "mlx"
        },
        {
          "op": "highlight",
          "target": {
            "selector": "#boundary"
          },
          "holdMs": 1400,
          "anchor": "local"
        },
        {
          "op": "pause",
          "ms": 300
        },
        {
          "op": "click",
          "target": {
            "selector": "#stages"
          }
        },
        {
          "op": "highlight",
          "target": {
            "selector": "#stage-record"
          },
          "holdMs": 1850,
          "anchor": "kept"
        },
        {
          "op": "pause",
          "ms": 2000
        }
      ]
    },
    {
      "id": "close",
      "title": "Install",
      "narration": "Add {{@install}}demo-tools beside aidemo, {{@render}}render, {{@revoice}}and revoice.",
      "actions": [
        {
          "op": "goto",
          "url": "http://127.0.0.1:8787/adds/05-close.html"
        },
        {
          "op": "waitFor",
          "target": {
            "selector": "#close-install"
          }
        },
        {
          "op": "pause",
          "ms": 200
        },
        {
          "op": "highlight",
          "target": {
            "selector": "#close-install"
          },
          "holdMs": 1950,
          "anchor": "install"
        },
        {
          "op": "highlight",
          "target": {
            "selector": "#close-render"
          },
          "holdMs": 550,
          "anchor": "render"
        },
        {
          "op": "highlight",
          "target": {
            "selector": "#close-revoice"
          },
          "holdMs": 1100,
          "anchor": "revoice"
        },
        {
          "op": "pause",
          "ms": 1400
        }
      ]
    }
  ]
}
